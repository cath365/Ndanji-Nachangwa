# Cloudinary image storage
# Set these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets.
CLOUDINARY_CLOUD_NAME=dwka1eckr
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Portfolio CMS
# ADMIN_KEY is the private password/key used to unlock publishing in admin.html.
ADMIN_KEY=choose_a_long_random_admin_key
# Fine-grained GitHub token: contents read/write access to this repository only.
CMS_GITHUB_TOKEN=your_github_token
CMS_GITHUB_REPO=cath365/Ndanji-Nachangwa
CMS_GITHUB_BRANCH=main
