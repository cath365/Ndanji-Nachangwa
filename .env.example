# Cloudinary image storage
# Set these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets.
CLOUDINARY_CLOUD_NAME=dwka1eckr
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Portfolio admin login
# Firebase email/password is the preferred admin sign-in method.
ADMIN_EMAIL=admin@example.com
ADMIN_SESSION_SECRET=generate_a_long_random_secret
FIREBASE_API_KEY=your_firebase_web_api_key

# Optional legacy password fallback. Remove after Firebase login is confirmed working.
ADMIN_PASSWORD=choose_a_strong_admin_password

# GitHub publishing from the CMS
# Use a fine-grained token restricted to this repository with Contents: Read and write.
GITHUB_TOKEN=your_fine_grained_github_token
GITHUB_REPO=cath365/Ndanji-Nachangwa
GITHUB_BRANCH=main

# Public portfolio deployment
# Create this in the PUBLIC portfolio Vercel project:
# Settings -> Git -> Deploy Hooks -> main
# Then add the generated HTTPS hook URL to the ADMIN project's environment variables.
# This makes Publish Changes trigger the public portfolio deployment immediately.
PUBLIC_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/your_public_project_hook
